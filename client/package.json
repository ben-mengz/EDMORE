{
  "name": "edmore-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "plugins:list": "node scripts/features.mjs list",
    "plugins:doctor": "node scripts/features.mjs doctor",
    "plugins:pack": "node scripts/package-features.mjs",
    "test:plugins": "node scripts/package-features.mjs && node --import tsx/esm --test packages/plugin-host/tests/*.test.mjs",
    "start": "node --import tsx/esm start.mjs",
    "test": "vitest run packages/plan-judge/tests packages/core/tests packages/jev-decisions/tests packages/weknora-sync/tests",
    "test:smoke": "node tests/smoke.mjs",
    "test:auth": "node --import tsx/esm --test packages/auth/tests/*.test.mjs",
    "test:portable": "node tests/portable.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-group": "1.0.4",
    "@deepseek-ai/dsh": "0.1.7-rc.2",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.7-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.7-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-brand": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-store": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.7-rc.2",
    "@deepseek-ai/dsh-deepseek-account": "0.1.7-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.7-rc.2",
    "@deepseek-ai/dsh-hook-protocol": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.7-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.1.7-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-query": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-telemetry": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-spill": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.7-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.7-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-rc.2",
    "@deepseek-ai/dsh-util-time": "0.1.7-rc.2",
    "@deepseek-ai/dsh-util-values": "0.1.7-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.1.7-rc.2",
    "@deepseek-ai/dsh-workflow": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "tsx": "4.22.4",
    "yaml": "2.8.3",
    "@edmore/plugin-host": "1.0.0",
    "@edmore/plugin-wiki": "1.0.0",
    "@edmore/plugin-remote": "1.0.0",
    "@edmore/plugin-hu": "1.0.0",
    "@edmore/plugin-bonsai": "1.0.0",
    "@edmore/plugin-strata": "1.0.0",
    "@edmore/plugin-tango": "1.0.0"
  },
  "devDependencies": {
    "vitest": "4.1.8"
  }
}
