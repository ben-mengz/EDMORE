@@ -0,0 +1,24 @@
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import test from 'node:test'
+import { mergeAllScopeKnowledgeBases } from './kbListMerge.ts'
+
+test('Lite knowledge lists expose all and shared scopes instead of trapping users in mine', () => {
+  const source = readFileSync(new URL('./KnowledgeBaseList.vue', import.meta.url), 'utf8')
+  assert.doesNotMatch(source, /hide-scopes="authStore\.isLiteMode"/)
+  assert.match(source, /const defaultScope = 'all'/)
+  assert.match(source, /RESERVED_SCOPES = new Set\(\['all', 'mine', 'shared'/)
+  assert.match(source, /:count-shared="sharedKbCount"/)
+  assert.doesNotMatch(source, /!authStore\.isLiteMode && showKbOriginBadge/)
+})
+
+test('shared-only view preserves viewer permission without exposing private knowledge', () => {
+  const rows = mergeAllScopeKnowledgeBases([], [{
+    knowledge_base: { id: 'public' }, permission: 'viewer',
+    share_id: 'share-public', shared_at: '2026-10-06', org_name: 'EDMORE Public Wiki',
+  }], 'user')
+  assert.equal(rows.length, 1)
+  assert.equal(rows[0].id, 'public')
+  assert.equal(rows[0].isMine, false)
+  assert.equal((rows[0] as any).permission, 'viewer')
+})
diff --git a/internal/application/repository/wiki_source_refs_sqlite_test.go b/internal/application/repository/wiki_source_refs_sqlite_test.go
new file mode 100644
index 0000000..0d51a36
--- /dev/null
+++ b/internal/application/repository/wiki_source_refs_sqlite_test.go
@@ -0,0 +1,47 @@
+package repository
+
+import (
+	"context"
+	"testing"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/stretchr/testify/require"
+)
+
+func TestWikiSourceRefsSQLite(t *testing.T) {
+	db := setupWikiPagesTestDB(t)
+	repo := NewWikiPageRepository(db)
+	ctx := context.Background()
+	// Wildcards, quotes, a backslash and Unicode must all be literal.
+	kid := "source_%\\\"'\u4e2d"
+	add := func(kb, slug, status, ref string) *types.WikiPage {
+		page := makeWikiPage(kb, slug, types.WikiPageTypeSummary, status)
+		page.SourceRefs = types.StringArray{ref}
+		require.NoError(t, db.Create(page).Error)
+		return page
+	}
+	add("kb", "bare", types.WikiPageStatusPublished, kid)
+	add("kb", "titled", types.WikiPageStatusPublished, kid+"|Title with | separator")
+	add("other-kb", "other", types.WikiPageStatusPublished, kid)
+	add("kb", "suffix", types.WikiPageStatusPublished, kid+"-other")
+	deleted := add("kb", "deleted", types.WikiPageStatusPublished, kid)
+	require.NoError(t, db.Delete(deleted).Error)
+	pages, err := repo.ListBySourceRef(ctx, "kb", kid)
+	require.NoError(t, err)
+	var slugs []string
+	for _, page := range pages {
+		slugs = append(slugs, page.Slug)
+	}
+	require.ElementsMatch(t, []string{"bare", "titled"}, slugs)
+	slugs, err = repo.ListSlugsBySourceRef(ctx, "kb", kid)
+	require.NoError(t, err)
+	require.ElementsMatch(t, []string{"bare", "titled"}, slugs)
+
+	add("kb", "archived", types.WikiPageStatusArchived, "archived-source")
+	add("kb", "second", types.WikiPageStatusPublished, "second-source|Title")
+	summaries, err := repo.ListSummariesByKnowledgeIDs(ctx, "kb", []string{kid, "second-source", "archived-source", "missing", ""})
+	require.NoError(t, err)
+	require.Len(t, summaries, 2)
+	require.Contains(t, []string{"body of bare", "body of titled"}, summaries[kid])
+	require.Equal(t, "body of second", summaries["second-source"])
+}
