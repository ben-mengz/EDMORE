index 0000000..8688eed
--- /dev/null
+++ b/frontend/src/stores/uploadConfirmDefaults.ts
@@ -0,0 +1,12 @@
+export async function loadUploadDefaults(
+  kbId: string,
+  fetchKnowledgeBase: (id: string) => Promise<any>,
+): Promise<any> {
+  if (!kbId) throw new Error('Knowledge base is required')
+  const response = await fetchKnowledgeBase(kbId)
+  const knowledgeBase = response?.data
+  if (!knowledgeBase || knowledgeBase.id !== kbId) {
+    throw new Error('Unable to load upload defaults for this knowledge base')
+  }
+  return knowledgeBase
+}
