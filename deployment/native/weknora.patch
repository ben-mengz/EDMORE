@@ -0,0 +1,19 @@
+import assert from 'node:assert/strict'
+import test from 'node:test'
+import { loadUploadDefaults } from './uploadConfirmDefaults.ts'
+
+test('every upload reads fresh knowledge-base model defaults', async () => {
+  let calls = 0
+  const fetchKb = async (id: string) => ({ data: {
+    id, vlm_config: { enabled: true, model_id: `vision-${++calls}` },
+  } })
+  assert.equal((await loadUploadDefaults('personal', fetchKb)).vlm_config.model_id, 'vision-1')
+  assert.equal((await loadUploadDefaults('personal', fetchKb)).vlm_config.model_id, 'vision-2')
+})
+
+test('preserves knowledge-base opt-out and never selects another tenant defaults', async () => {
+  const disabled = { id: 'private', vlm_config: { enabled: false, model_id: '' } }
+  assert.deepEqual(await loadUploadDefaults('private', async () => ({ data: disabled })), disabled)
+  await assert.rejects(loadUploadDefaults('private', async () => ({ data: { id: 'other' } })))
+  await assert.rejects(loadUploadDefaults('private', async () => { throw new Error('Network error') }))
+})
