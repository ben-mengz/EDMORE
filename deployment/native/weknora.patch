+package service
+
+import (
+	"context"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/stretchr/testify/require"
+	"testing"
+	"time"
+)
+
+func TestLiteMoveProgressDoesNotRequireRedis(t *testing.T) {
+	s := &knowledgeService{}
+	ctx := context.Background()
+	current := &types.KnowledgeMoveProgress{TaskID: "move", SourceKBID: "source", TargetKBID: "target", Progress: 100}
+	require.NoError(t, s.saveKnowledgeMoveProgress(ctx, current))
+	require.NoError(t, s.SaveKnowledgeMoveProgress(ctx, &types.KnowledgeMoveProgress{TaskID: "move", Progress: 0}))
+	current.Progress = 10
+	saved, err := s.GetKnowledgeMoveProgress(ctx, "move")
+	require.NoError(t, err)
+	require.Equal(t, 100, saved.Progress)
+	require.Equal(t, "source", saved.SourceKBID)
+	s.moveProgress.Store("expired", liteMoveProgress{expires: time.Now().Add(-time.Second)})
+	_, err = s.GetKnowledgeMoveProgress(ctx, "expired")
+	require.Error(t, err)
+	_, err = (&knowledgeService{}).GetKnowledgeMoveProgress(ctx, "move")
+	require.Error(t, err)
+}
