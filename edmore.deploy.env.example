# EDMORE deployment configuration.
# Copy to edmore.deploy.env (repository root, git-ignored) on the Mac, and to
# ~/.config/edmore/deploy.env on the cluster. Never commit the filled-in copy.
# Values are bash; later lines may reference earlier ones.

# SSH alias (from ~/.ssh/config) that sync-server.sh uploads to.
EDMORE_SSH_HOST=my-cluster

# Cluster storage layout.
EDMORE_OPS_ROOT=/path/to/ops/username
EDMORE_BASE=$EDMORE_OPS_ROOT/Container/base_container/edmore
EDMORE_DATA_DIR=$EDMORE_OPS_ROOT/edmore-data
EDMORE_WORKSPACE_DIR=$EDMORE_OPS_ROOT/edmore-workspace
EDMORE_WIKI_SYNC_DIR=$EDMORE_OPS_ROOT/edmore-wiki-sync
WEKNORA_ROOT=$EDMORE_OPS_ROOT/weknora
EDMORE_WIKI_DATA_DIR=$WEKNORA_ROOT/data
WEKNORA_BINARY=$WEKNORA_ROOT/build/WeKnora-lite-move-fix
EDMORE_REGISTRATION_ROOT=$EDMORE_OPS_ROOT/tem-registration
EDMORE_TANGO_ACCESS_DIR=$EDMORE_REGISTRATION_ROOT/harness-access
EDMORE_CONTAINER=$EDMORE_BASE/edmore-wiki.sif
EDMORE_BUILD_CONTAINER=$EDMORE_BASE/edmore.sif

# Slurm placement.
EDMORE_SLURM_PARTITION=my-partition
EDMORE_SLURM_NODE=my-node

# Public URLs are http://<node short name>.<domain>:<port>.
EDMORE_PUBLIC_DOMAIN=example.org
EDMORE_PORT=7380
EDMORE_REGISTRATION_URL=https://my-node.example.org:8780
EDMORE_WIKI_PUBLIC_URL=http://my-node.example.org:8080

# Accounts and optional Strata tunnel (leave EDMORE_STRATA_TUNNEL empty to skip).
EDMORE_AUTH=1
EDMORE_ADMIN_USER=admin
EDMORE_STRATA_TUNNEL=user@strata-node
